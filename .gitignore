# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Self-update staging and rollback. Ignored for correctness, not tidiness: the
# next update runs `git clean -fd`, and a tracked-but-untracked `.next-old`
# would be deleted — that is the only copy of the build to roll back to.
/.next-update/
/.next-old/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# RunPanel runtime data
/data/

# IDE
.idea/
.vscode/
