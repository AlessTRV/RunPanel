# RunPanel configuration
# Copy to .env and adjust. Every value below is validated at boot — a bad value
# stops the server with an explanatory error instead of failing on first use.
#
# Everything here is RunPanel's OWN configuration. None of these variables are
# passed through to the projects you deploy: they are stripped from the child
# environment (see PRIVATE_ENV_KEYS in lib/env.ts), because RUNPANEL_SECRET is
# the key your projects' env vars are encrypted with.

# ── Core ─────────────────────────────────────────────────────────────────────

# Key used to encrypt env vars and service credentials at rest.
# Must be hex, at least 64 characters (32 bytes). Leave empty and RunPanel
# generates one at <data dir>/.secret on first run.
#   openssl rand -hex 32
RUNPANEL_SECRET=

# Where repos, uploads, logs and the SQLite store live. Default: ./data
RUNPANEL_DATA_DIR=

# Port the panel itself listens on. Default: 3000
PORT=3000

# How many reverse proxies sit in front of the panel. Default: 0
#
# Set this if anything terminates TLS or forwards to RunPanel — nginx, Caddy,
# Traefik, Cloudflare. It is what makes the per-address login limit work.
#
# `X-Forwarded-For` is a list every hop APPENDS to, so the leftmost entry is
# whatever the client typed. With n trusted proxies the address the outermost
# one saw is the nth from the RIGHT, and that is the entry counted here.
# Leave it at 0 when the panel is reached directly: the header is then ignored
# entirely and only the account-wide login limit applies.
#
# One nginx in front means 1. Cloudflare in front of nginx means 2.
# RUNPANEL_TRUSTED_PROXY_HOPS=1

# Pin the first-run setup token instead of generating one. Default: unset
#
# Until an admin password exists, anyone who reaches the panel could set it,
# so the setup screen asks for a token. Normally the panel mints one at boot
# and prints it to its own log — read it there. Set this only when a
# provisioning script has to complete the setup unattended.
# RUNPANEL_SETUP_TOKEN=

# Turn off every background timer: Docker housekeeping, scheduled backups and
# the boot reconciler that restarts what is marked for autostart. Set it when
# several panels share one data set, or when running a throwaway instance that
# must not touch the host. Accepts 1/0, true/false, yes/no. Default: off.
# RUNPANEL_DISABLE_SCHEDULERS=1

# Extra hostnames allowed to load dev-only resources (HMR, the dev overlay),
# comma separated. Only needed in development, and only when you reach the
# panel at something other than localhost — a hostname on your own domain, a
# tunnel, a LAN name. Without it hot reload is blocked cross-origin.
# Matched by DNS segment: "*.example.com" works, CIDR ranges do NOT.
# 127.0.0.1, 192.168.*.* and 10.*.*.* are already allowed.
# RUNPANEL_DEV_ORIGINS=panel.example.com,*.example.com

# ── Store ────────────────────────────────────────────────────────────────────

# sqlite (default, zero-config, single local file) or postgres (external server).
RUNPANEL_DB_DRIVER=sqlite

# --- when RUNPANEL_DB_DRIVER=sqlite ---
# Path to the database file. Default: <data dir>/runpanel.db
RUNPANEL_DB_FILE=

# --- when RUNPANEL_DB_DRIVER=postgres ---
# Either give a full URL...
# RUNPANEL_DATABASE_URL=postgresql://user:password@localhost:5432/runpanel?sslmode=require
#
# ...or the parts. The URL wins if both are present.
# RUNPANEL_PG_HOST=localhost
# RUNPANEL_PG_PORT=5432
# RUNPANEL_PG_USER=runpanel
# RUNPANEL_PG_PASSWORD=
# RUNPANEL_PG_DATABASE=runpanel
#
# disable (default) | require (verify the certificate) | no-verify (encrypt, don't verify)
# RUNPANEL_PG_SSL=disable
#
# Maximum pooled connections. Default: 10
# RUNPANEL_PG_POOL_MAX=10
#
# Note: plain DATABASE_URL is also accepted as a fallback for
# RUNPANEL_DATABASE_URL, but prefer the prefixed name — DATABASE_URL is a very
# common variable and the prefixed one cannot be confused with a project's own.
